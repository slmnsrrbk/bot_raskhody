# Получить на https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# Нейросеть: chadgpt (как в боте расходов) или openai (любой OpenAI-совместимый API)
AI_PROVIDER=chadgpt
AI_API_KEY=chad-xxxxxxxx
AI_MODEL=gpt-4o-mini
# Только для AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1

# Сколько секунд ждать, пока человек допишет несколько сообщений подряд
DEBOUNCE_SECONDS=8
# Сколько последних сообщений переписки отдавать нейросети
HISTORY_LIMIT=30
# Если ты сам написал в чат, бот замолкает в нём на столько минут
TAKEOVER_MINUTES=60
