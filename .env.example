# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
TELEGRAM_TOKEN=

# Ключ API ChadGPT (https://chadgpt.ru). Можно оставить пустым — тогда категория всегда «Другое»
CHAD_API_KEY=

# chat_id, куда слать автоотчёты. Узнать: отправьте боту /start — он покажет ваш chat_id
REPORT_CHAT_ID=

# Название Google Таблицы (должна быть расшарена на email сервисного аккаунта из credentials.json)
SHEET_NAME=Мои расходы

# Путь к JSON-ключу сервисного аккаунта Google (по умолчанию credentials.json рядом с main.py)
# GOOGLE_CREDENTIALS_FILE=/root/bot/credentials.json

# Где хранить лимиты (по умолчанию limits.json рядом с main.py)
# LIMITS_FILE=/root/bot/limits.json

# Часовой пояс и время ежедневного автоотчёта
TIMEZONE=Asia/Krasnoyarsk
DAILY_REPORT_TIME=21:00
